<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">

      <a href="/" class="site-logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo -%}
          <img
            class="logo-img"
            src="{{ section.settings.logo | img_url: '300x' }}"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            width="{{ section.settings.logo.width | at_most: section.settings.logo_max_width }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <div class="logo-text">
            <span class="logo-name">{{ shop.name }}</span>
            <span class="logo-tagline">¡Diversión garantizada!</span>
          </div>
        {%- endif -%}
      </a>

      <div class="header-search">
        <form class="search-form" action="/search" method="get" role="search">
          <input
            class="search-input"
            type="search"
            name="q"
            placeholder="Buscar juguetes, marcas, edades..."
            aria-label="Buscar productos"
            autocomplete="off"
          >
          <button class="search-btn" type="submit" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </button>
        </form>
      </div>

      <div class="header-actions">
        <a href="/account" class="header-action-btn" aria-label="Mi cuenta" title="Mi cuenta">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </a>

        <button class="header-action-btn" data-wishlist-open aria-label="Favoritos" title="Favoritos" style="position:relative;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="wishlist-badge" style="display:none;">0</span>
        </button>

        <button class="header-action-btn" data-cart-open aria-label="Carrito de compras" title="Carrito">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-badge" style="display:none;">0</span>
        </button>

        <button class="btn-menu" aria-label="Menú" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la tienda",
      "info": "Sube tu logotipo (PNG con fondo transparente recomendado)"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Ancho del logo",
      "min": 60,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 150
    }
  ]
}
{% endschema %}
