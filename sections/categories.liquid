<section class="categories-section" aria-labelledby="categories-title">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title" id="categories-title">Compra por categoría</h2>
        <p class="section-subtitle">Encuentra el juguete perfecto para cada edad y momento</p>
      </div>
      <a href="/collections/all" class="btn btn-secondary">Ver todos →</a>
    </div>

    <div class="categories-grid">
      <a href="/collections/bebes" class="category-card">
        <span class="category-emoji">👶</span>
        <span class="category-name">Bebés</span>
        <span class="category-count">0–2 años</span>
      </a>
      <a href="/collections/preescolar" class="category-card">
        <span class="category-emoji">🎨</span>
        <span class="category-name">Preescolar</span>
        <span class="category-count">3–5 años</span>
      </a>
      <a href="/collections/ninos" class="category-card">
        <span class="category-emoji">🚗</span>
        <span class="category-name">Niños</span>
        <span class="category-count">6–10 años</span>
      </a>
      <a href="/collections/adolescentes" class="category-card">
        <span class="category-emoji">🎮</span>
        <span class="category-name">Adolescentes</span>
        <span class="category-count">11+ años</span>
      </a>
      <a href="/collections/outdoor" class="category-card">
        <span class="category-emoji">🏃</span>
        <span class="category-name">Outdoor</span>
        <span class="category-count">Aire libre</span>
      </a>
      <a href="/collections/educativos" class="category-card">
        <span class="category-emoji">📚</span>
        <span class="category-name">Educativos</span>
        <span class="category-count">Aprende jugando</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "settings": [],
  "presets": [{ "name": "Categorías" }]
}
{% endschema %}
