<section class="categories-section" aria-labelledby="categories-title">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title" id="categories-title">Compra por categoría</h2>
        <p class="section-subtitle">Encuentra el juguete perfecto para cada edad y momento</p>
      </div>
      <a href="/collections/all" class="btn btn-secondary">Ver todos →</a>
    </div>

    <div class="categories-grid">
      <a href="/collections/munecas" class="category-card">
        <span class="category-emoji">👧</span>
        <span class="category-name">Muñecas</span>
        <span class="category-count">Colección</span>
      </a>
      <a href="/collections/juguetes-de-accion" class="category-card">
        <span class="category-emoji">🦸</span>
        <span class="category-name">Juguetes de acción</span>
        <span class="category-count">Colección</span>
      </a>
      <a href="/collections/juguetes-interactivos-y-educativos" class="category-card">
        <span class="category-emoji">📚</span>
        <span class="category-name">Interactivos y educativos</span>
        <span class="category-count">Colección</span>
      </a>
      <a href="/collections/vuelo-y-aventura" class="category-card">
        <span class="category-emoji">🚀</span>
        <span class="category-name">Vuelo y aventura</span>
        <span class="category-count">Outdoor</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "settings": [],
  "presets": [{ "name": "Categorías" }]
}
{% endschema %}
