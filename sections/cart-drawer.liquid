<div class="cart-overlay"></div>

<div class="cart-drawer" role="dialog" aria-label="Carrito de compras" aria-modal="true">
  <div class="cart-drawer-header">
    <h2>🛒 Mi Carrito</h2>
    <button class="cart-close" aria-label="Cerrar carrito">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer-body">
    {%- if cart.item_count == 0 -%}
      <div style="text-align:center;padding:60px 20px;color:var(--color-text-light);">
        <div style="font-size:4rem;margin-bottom:16px;">🛒</div>
        <h3 style="font-weight:800;margin-bottom:8px;color:var(--color-text);">Tu carrito está vacío</h3>
        <p style="font-size:0.88rem;margin-bottom:24px;">¡Explora nuestros productos y encuentra el juguete perfecto!</p>
        <button onclick="closeCart();window.location='/collections/all'" class="btn btn-primary">Ver productos</button>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" data-item-key="{{ item.key }}">
          <img
            class="cart-item-img"
            src="{{ item.product.featured_image | img_url: '120x120', crop: 'center' }}"
            alt="{{ item.title }}"
            loading="lazy"
          >
          <div class="cart-item-info">
            <p class="cart-item-title">{{ item.product.title }}</p>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-item-controls">
              <div class="qty-control" data-line-key="{{ item.key }}">
                <button class="qty-btn" data-action="decrease" aria-label="Disminuir cantidad">−</button>
                <input class="qty-value" type="number" value="{{ item.quantity }}" min="1" max="99" aria-label="Cantidad" readonly>
                <button class="qty-btn" data-action="increase" aria-label="Aumentar cantidad">+</button>
              </div>
              <span class="cart-item-price">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
  <div class="cart-drawer-footer">
    <div style="background:rgba(27,138,60,0.06);border-radius:var(--radius-md);padding:12px 16px;display:flex;align-items:center;gap:10px;font-size:0.82rem;color:var(--color-primary-dark);font-weight:600;">
      🚚 <span>Faltan <strong data-free-shipping-amount>$0</strong> para envío gratis</span>
    </div>

    <div class="cart-subtotal">
      <span>Subtotal</span>
      <span data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>

    <a href="/checkout" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
      🔒 Finalizar compra
    </a>

    <a href="/cart" class="btn btn-secondary" style="width:100%;justify-content:center;">
      Ver carrito completo
    </a>

    <p class="cart-note">🔒 Pago 100% seguro · Devolución gratis en 30 días</p>
  </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrito drawer",
  "settings": []
}
{% endschema %}
