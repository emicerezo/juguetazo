<section class="offers-section" aria-labelledby="offers-title">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title" id="offers-title">Ofertas especiales</h2>
        <p class="section-subtitle">Aprovecha antes de que se agoten</p>
      </div>
    </div>

    <div class="offers-grid">

      <div class="offer-card offer-card-main">
        <div class="offer-pattern"></div>
        <div class="offer-content">
          <span class="offer-tag">🚚 Envío gratis incluido</span>
          <h2 class="offer-title">¡Última pieza!<br>Envío gratis</h2>
          <p class="offer-subtitle">Productos con solo 1 unidad disponible — llévalo antes de que se agote</p>

          <div style="display:flex;gap:12px;align-items:center;margin-bottom:28px;">
            <div style="background:rgba(255,255,255,0.15);border-radius:var(--radius-md);padding:12px 16px;backdrop-filter:blur(8px);display:flex;align-items:center;gap:8px;">
              <span style="font-size:1.6rem;">📦</span>
              <div>
                <div style="font-size:1.1rem;font-weight:900;line-height:1;">1 pieza</div>
                <div style="font-size:0.7rem;opacity:0.8;">en inventario</div>
              </div>
            </div>
            <div style="background:rgba(255,255,255,0.15);border-radius:var(--radius-md);padding:12px 16px;backdrop-filter:blur(8px);display:flex;align-items:center;gap:8px;">
              <span style="font-size:1.6rem;">🚚</span>
              <div>
                <div style="font-size:1.1rem;font-weight:900;line-height:1;">Gratis</div>
                <div style="font-size:0.7rem;opacity:0.8;">envío incluido</div>
              </div>
            </div>
          </div>

          <a href="/collections/ultimas-piezas" class="btn btn-accent">
            Ver últimas piezas →
          </a>
        </div>
      </div>

      <div class="offer-card offer-card-secondary">
        <div class="offer-pattern"></div>
        <div class="offer-content">
          <span class="offer-tag" style="background:white;color:var(--color-text)">⚡ Flash Sale</span>
          <h2 class="offer-title">2x1 en juguetes<br>educativos</h2>
          <p class="offer-subtitle">Lleva 2 y paga solo 1 en productos seleccionados</p>

          <div style="font-size:2.5rem;margin-bottom:24px;animation:float 3s ease-in-out infinite;">
            📚🎯🔬
          </div>

          <a href="/collections/juguetes-interactivos-y-educativos" class="btn" style="background:white;color:var(--color-primary-dark);font-weight:800;border-radius:9999px;padding:12px 28px;">
            Ver productos →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ofertas especiales",
  "settings": [],
  "presets": [{ "name": "Ofertas especiales" }]
}
{% endschema %}
