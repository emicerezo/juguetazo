<div class="container" style="padding-top:40px;padding-bottom:64px;max-width:900px;">
  <h1 style="font-size:2rem;font-weight:900;margin-bottom:32px;color:var(--color-primary-dark);">🛒 Mi Carrito</h1>

  {%- if cart.item_count == 0 -%}
    <div style="text-align:center;padding:80px 20px;">
      <div style="font-size:5rem;margin-bottom:20px;">🛒</div>
      <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:12px;">Tu carrito está vacío</h2>
      <p style="color:var(--color-text-light);margin-bottom:32px;">¡Descubre nuestra increíble selección de juguetes!</p>
      <a href="/collections/all" class="btn btn-primary btn-lg">Ver todos los productos</a>
    </div>
  {%- else -%}

    <div style="display:grid;grid-template-columns:1fr 360px;gap:32px;align-items:start;">

      <!-- Cart Items -->
      <div>
        {%- form 'cart', cart -%}
          {%- for item in cart.items -%}
            <div style="display:flex;gap:20px;padding:20px 0;border-bottom:1.5px solid var(--color-border);">
              <img
                src="{{ item.product.featured_image | img_url: '150x150', crop: 'center' }}"
                alt="{{ item.title }}"
                style="width:100px;height:100px;object-fit:cover;border-radius:var(--radius-md);background:var(--color-gray-light);flex-shrink:0;"
              >
              <div style="flex:1;">
                {%- if item.product.vendor -%}
                  <span style="font-size:0.72rem;font-weight:700;color:var(--color-primary);text-transform:uppercase;">{{ item.product.vendor }}</span>
                {%- endif -%}
                <h3 style="font-size:0.95rem;font-weight:700;margin:4px 0;line-height:1.3;">
                  <a href="{{ item.product.url }}" style="color:var(--color-text);text-decoration:none;">{{ item.product.title }}</a>
                </h3>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p style="font-size:0.8rem;color:var(--color-text-light);margin-bottom:8px;">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
                  <div class="qty-control" data-line-key="{{ item.key }}" style="border:1.5px solid var(--color-border);border-radius:9999px;overflow:hidden;display:flex;">
                    <button class="qty-btn" data-action="decrease" style="width:32px;height:32px;background:var(--color-gray-light);font-weight:700;cursor:pointer;border:none;transition:all 0.2s;">−</button>
                    <input class="qty-value" type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width:40px;text-align:center;font-weight:800;font-size:0.9rem;border:none;outline:none;">
                    <button class="qty-btn" data-action="increase" style="width:32px;height:32px;background:var(--color-gray-light);font-weight:700;cursor:pointer;border:none;transition:all 0.2s;">+</button>
                  </div>
                  <span style="font-size:1.1rem;font-weight:900;color:var(--color-primary-dark);">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
          <button type="submit" name="update" style="display:none;">Actualizar</button>
        {%- endform -%}
      </div>

      <!-- Order Summary -->
      <div style="background:var(--color-off-white);border-radius:var(--radius-xl);padding:28px;border:1.5px solid var(--color-border);position:sticky;top:calc(var(--header-height) + 20px);">
        <h2 style="font-size:1.1rem;font-weight:800;margin-bottom:20px;">Resumen del pedido</h2>

        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;padding-bottom:20px;border-bottom:1.5px solid var(--color-border);">
          <div style="display:flex;justify-content:space-between;font-size:0.88rem;">
            <span style="color:var(--color-text-light);">Subtotal ({{ cart.item_count }} artículos)</span>
            <span style="font-weight:700;">{{ cart.total_price | money }}</span>
          </div>
          {%- if cart.total_price >= 69900 -%}
            <div style="display:flex;justify-content:space-between;font-size:0.88rem;color:var(--color-primary);">
              <span>🚚 Envío</span>
              <span style="font-weight:700;">GRATIS</span>
            </div>
          {%- else -%}
            <div style="background:rgba(27,138,60,0.08);border-radius:var(--radius-sm);padding:10px;font-size:0.8rem;color:var(--color-primary-dark);">
              🚚 Te faltan <strong>{{ 69900 | minus: cart.total_price | money }}</strong> para envío gratis
            </div>
          {%- endif -%}
        </div>

        <div style="display:flex;justify-content:space-between;font-size:1.1rem;font-weight:900;margin-bottom:24px;">
          <span>Total</span>
          <span style="color:var(--color-primary-dark);">{{ cart.total_price | money }} MXN</span>
        </div>

        <a href="/checkout" class="btn btn-primary" style="width:100%;justify-content:center;padding:16px;font-size:1rem;">
          🔒 Finalizar compra
        </a>

        <div style="display:flex;justify-content:center;gap:8px;margin-top:16px;flex-wrap:wrap;">
          <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 26'%3E%3Crect width='40' height='26' rx='4' fill='%231B8A3C' opacity='.1'/%3E%3Ctext x='50%25' y='60%25' text-anchor='middle' font-size='8' font-weight='bold' fill='%231B8A3C'%3EVISA%3C/text%3E%3C/svg%3E" width="40" alt="VISA">
        </div>

        <p style="text-align:center;font-size:0.75rem;color:var(--color-text-light);margin-top:12px;">🔒 Transacción 100% segura y encriptada</p>

        <a href="/collections/all" style="display:block;text-align:center;margin-top:16px;font-size:0.85rem;color:var(--color-primary);text-decoration:none;font-weight:600;">← Seguir comprando</a>
      </div>

    </div>

  {%- endif -%}
</div>

<style>
@media (max-width:768px) {
  .container > div[style*="grid-template-columns:1fr 360px"] { grid-template-columns: 1fr !important; }
}
</style>
