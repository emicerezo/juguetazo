[
  {
    "name": "theme_info",
    "theme_name": "Juguetazo",
    "theme_version": "1.0.0",
    "theme_author": "Juguetazo México",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Color primario",
        "default": "#1B8A3C"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Color primario oscuro",
        "default": "#145E2A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Color de acento",
        "default": "#FFD600"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Fuente de títulos",
        "default": "nunito_n8"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Fuente de cuerpo",
        "default": "nunito_n4"
      }
    ]
  },
  {
    "name": "Tienda",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Nombre de la tienda",
        "default": "Juguetazo"
      },
      {
        "type": "text",
        "id": "store_tagline",
        "label": "Eslogan",
        "default": "¡Diversión garantizada!"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "label": "Ancho máximo del logo",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 150
      }
    ]
  },
  {
    "name": "Envíos",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Mínimo para envío gratis (en centavos)",
        "default": 69900
      },
      {
        "type": "text",
        "id": "shipping_badge_text",
        "label": "Texto del badge de envío",
        "default": "Envío GRATIS en compras mayores a $699 MXN"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_whatsapp",
        "label": "WhatsApp URL (wa.me/...)"
      }
    ]
  },
  {
    "name": "Contacto",
    "settings": [
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Teléfono",
        "default": "800 JUGUETAZO"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email",
        "default": "hola@juguetazo.mx"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Horario de atención",
        "default": "Lun–Vie: 9am–7pm · Sáb: 9am–2pm"
      }
    ]
